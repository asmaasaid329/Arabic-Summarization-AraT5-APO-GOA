    "train": load_jsonl(train_path),
    "validation": load_jsonl(val_path),
    "test": load_jsonl(test_path),
})

print("\nDataset sizes:", {k: len(v) for k, v in dataset.items()})

tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)


def preprocess(batch):
    inputs = ["summarize: " + str(x) for x in batch["text"]]
    model_inputs = tokenizer(inputs, max_length=MAX_INPUT_TOKENIZE_LEN, truncation=True)
    labels = tokenizer(text_target=[str(x) for x in batch["summary"]],
                       max_length=MAX_TARGET_LEN, truncation=True)
    model_inputs["labels"] = [
        [tok if tok != tokenizer.pad_token_id else -100 for tok in ids]
        for ids in labels["input_ids"]
    ]
    return model_inputs


tokenized = dataset.map(preprocess, batched=True,
                        remove_columns=dataset["train"].column_names)


def truncate_dataset(split, max_length):
    def trunc_map(batch):
        return {
            "input_ids": [ids[:max_length] for ids in batch["input_ids"]],
            "attention_mask": [m[:max_length] for m in batch["attention_mask"]],
            "labels": batch["labels"],
        }
    return split.map(trunc_map, batched=True, remove_columns=split.column_names)

rouge = evaluate.load("rouge")
bleu = evaluate.load("bleu")
meteor = evaluate.load("meteor")
bertscore = evaluate.load("bertscore")


def compute_metrics(eval_pred):
    predictions, labels = eval_pred
    if isinstance(predictions, tuple):
        predictions = predictions[0]

    predictions = np.asarray(predictions)
    labels = np.asarray(labels)

    # generated sequences are padded with -100 across batches; the
    # tokenizer cannot decode -100 (OverflowError)
    predictions = np.where(predictions != -100, predictions, tokenizer.pad_token_id)
    labels = np.where(labels != -100, labels, tokenizer.pad_token_id)

    decoded_preds = [x.strip() for x in tokenizer.batch_decode(predictions, skip_special_tokens=True)]
    decoded_labels = [x.strip() for x in tokenizer.batch_decode(labels, skip_special_tokens=True)]

    out = {}
    r = rouge.compute(predictions=decoded_preds, references=decoded_labels,
                      use_stemmer=False, tokenizer=lambda s: s.split())
    for k, v in r.items():
        out[f"rouge_{k}"] = float(v * 100)
    b = bleu.compute(predictions=decoded_preds, references=[[x] for x in decoded_labels],
                     tokenizer=lambda s: s.split())
    out["BLEU"] = float(b["bleu"] * 100)
    m = meteor.compute(predictions=decoded_preds, references=decoded_labels)
    out["METEOR"] = float(m["meteor"] * 100)
    bs = bertscore.compute(predictions=decoded_preds, references=decoded_labels, lang="ar")
    out["BERTScore_F1"] = float(np.mean(bs["f1"]) * 100)
    return out

def find_valid_checkpoint(folder):
    cands = []
    for path in glob.glob(os.path.join(folder, "checkpoint-*")):
        if not os.path.isdir(path):
            continue
        try:
            step = int(os.path.basename(path).split("-")[-1])
        except ValueError:
            continue
        has_w = (os.path.exists(os.path.join(path, "model.safetensors"))
                 or os.path.exists(os.path.join(path, "pytorch_model.bin")))
        ok = (has_w
              and os.path.exists(os.path.join(path, "trainer_state.json"))
              and os.path.exists(os.path.join(path, "optimizer.pt"))
              and os.path.exists(os.path.join(path, "scheduler.pt")))
        if ok:
            cands.append((step, path))
    return max(cands)[1] if cands else None

# ================================================================
# TRAIN EACH SEED
# ================================================================

os.environ["WANDB_DISABLED"] = "true"

for seed in SEEDS:

    seed_dir = os.path.join(DRIVE_ROOT, f"seed_{seed}")
    train_dir = os.path.join(seed_dir, "training")
    final_dir = os.path.join(seed_dir, "final_model")
    summary_file = os.path.join(seed_dir, "seed_summary.json")   # written LAST

    print("\n" + "#" * 70 + f"\nBASELINE - SEED {seed}\n" + "#" * 70)

    if os.path.isfile(summary_file):
        print(f"Seed {seed} already finished - skipping.")
        continue

    os.makedirs(train_dir, exist_ok=True)
    set_all_seeds(seed)

    model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME).to(DEVICE)

    train_ds = truncate_dataset(tokenized["train"], MAX_INPUT_LENGTH)
    val_ds = truncate_dataset(tokenized["validation"], MAX_INPUT_LENGTH)

    collator = DataCollatorForSeq2Seq(tokenizer=tokenizer, model=model, padding=True)

    args = Seq2SeqTrainingArguments(
        output_dir=train_dir,
        eval_strategy="epoch",
        logging_strategy="epoch",
        save_strategy="epoch",
        learning_rate=LEARNING_RATE,
        per_device_train_batch_size=BATCH_SIZE,
        per_device_eval_batch_size=EVAL_BATCH_SIZE,
        weight_decay=WEIGHT_DECAY,
        num_train_epochs=FINAL_EPOCHS,
        gradient_accumulation_steps=GRAD_ACCUM,
        predict_with_generate=True,
        generation_num_beams=FINAL_NUM_BEAMS,
        generation_max_length=MAX_GENERATION_LENGTH,
        fp16=USE_FP16,
        save_total_limit=2,
        load_best_model_at_end=True,       
        dataloader_num_workers=2,
        report_to="none",
        seed=seed,
        data_seed=seed,
        remove_unused_columns=True,
    )

    trainer = Seq2SeqTrainer(
        model=model,
        args=args,
        train_dataset=train_ds,
        eval_dataset=val_ds,
        processing_class=tokenizer,
        data_collator=collator,
        compute_metrics=compute_metrics,
    )

    ckpt = find_valid_checkpoint(train_dir)
    if ckpt:
        print("Resuming from:", ckpt)
        result = trainer.train(resume_from_checkpoint=ckpt)
    else:
        result = trainer.train()

    trainer.save_model(final_dir)
    tokenizer.save_pretrained(final_dir)

    evals = [x for x in trainer.state.log_history if "eval_rouge_rouge1" in x]
    last_eval = evals[-1] if evals else {}

    atomic_json_dump(
        {
            "seed": seed,
            "model": MODEL_NAME,
            "best_hyperparameters": BASELINE_HP,      
            "final_epochs": FINAL_EPOCHS,
            "final_model_rule": "last epoch",
            "last_epoch_validation_metrics": last_eval,
            "train_metrics": result.metrics,
        },
        summary_file,
    )

    print(f"Seed {seed} finished. Final model: {final_dir}")

    del trainer, model
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
        torch.cuda.ipc_collect()

